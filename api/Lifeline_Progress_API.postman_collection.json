{
  "info": {
    "name": "Lifeline - Progress & Stats API",
    "description": "Postman collection for all the missing Progress/Stats API endpoints in the Lifeline application.\n\nIncludes:\n1. Calories Intake Aggregation\n2. Exercise Active Days (Weekly Summary)\n3. Medication Stats\n4. User Challenge Progress\n5. Full Progress Summary\n6. App Settings CRUD\n\n**Setup:** Run the 'Login' request first to get a token, then set it in the collection variable `accessToken`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "lifeline-api"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "password123",
      "type": "string"
    },
    {
      "key": "appSettingId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth (Setup)",
      "description": "Run these first to get an access token for testing.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', response.data.accessToken);",
                  "    console.log('Access token saved!');",
                  "}",
                  "",
                  "pm.test('Login successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(response.success).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login to get an access token. The token is automatically saved to the collection variable `accessToken`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Progress APIs",
      "description": "All missing progress/stats aggregation endpoints.",
      "item": [
        {
          "name": "1. Full Progress Summary",
          "item": [
            {
              "name": "Get Progress Summary",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const response = pm.response.json();",
                      "",
                      "pm.test('Status code is 200', function() {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Response has correct structure', function() {",
                      "    pm.expect(response.success).to.be.true;",
                      "    pm.expect(response.data).to.have.property('caloriesIntake');",
                      "    pm.expect(response.data).to.have.property('exerciseActiveDays');",
                      "    pm.expect(response.data).to.have.property('medicationStats');",
                      "    pm.expect(response.data).to.have.property('challengeProgress');",
                      "    pm.expect(response.data).to.have.property('waterIntake');",
                      "});",
                      "",
                      "pm.test('Calories intake has required fields', function() {",
                      "    const cal = response.data.caloriesIntake;",
                      "    pm.expect(cal).to.have.property('today');",
                      "    pm.expect(cal).to.have.property('target');",
                      "    pm.expect(cal).to.have.property('percentage');",
                      "});",
                      "",
                      "pm.test('Exercise active days has required fields', function() {",
                      "    const ex = response.data.exerciseActiveDays;",
                      "    pm.expect(ex).to.have.property('activeDays');",
                      "    pm.expect(ex).to.have.property('totalDays');",
                      "    pm.expect(ex).to.have.property('percentage');",
                      "});",
                      "",
                      "pm.test('Medication stats has required fields', function() {",
                      "    const med = response.data.medicationStats;",
                      "    pm.expect(med).to.have.property('totalMedications');",
                      "    pm.expect(med).to.have.property('adherencePercent');",
                      "});",
                      "",
                      "pm.test('Challenge progress has required fields', function() {",
                      "    const ch = response.data.challengeProgress;",
                      "    pm.expect(ch).to.have.property('totalJoined');",
                      "    pm.expect(ch).to.have.property('completed');",
                      "    pm.expect(ch).to.have.property('inProgress');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/progress/summary",
                  "host": ["{{baseUrl}}"],
                  "path": ["progress", "summary"]
                },
                "description": "Get all progress data in one aggregated response. This is the main endpoint for the Progress Screen.\n\nReturns:\n- Calories intake (today's total, target, percentage)\n- Exercise active days (last 7 days)\n- Medication stats (adherence %)\n- Challenge progress (completed, in-progress)\n- Water intake (today's total vs goal)\n- Sleep (last log)\n- Fasting (last log)"
              },
              "response": [
                {
                  "name": "Success Response",
                  "originalRequest": {
                    "method": "GET",
                    "url": {
                      "raw": "{{baseUrl}}/progress/summary",
                      "host": ["{{baseUrl}}"],
                      "path": ["progress", "summary"]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "body": "{\n  \"success\": true,\n  \"data\": {\n    \"caloriesIntake\": {\n      \"today\": 256,\n      \"target\": 2000,\n      \"percentage\": 13\n    },\n    \"exerciseActiveDays\": {\n      \"activeDays\": 3,\n      \"totalDays\": 7,\n      \"percentage\": 43,\n      \"exercisesCompletedThisWeek\": 5\n    },\n    \"medicationStats\": {\n      \"totalMedications\": 3,\n      \"activeMedications\": 2,\n      \"adherencePercent\": 67\n    },\n    \"challengeProgress\": {\n      \"totalJoined\": 4,\n      \"completed\": 2,\n      \"inProgress\": 2\n    },\n    \"waterIntake\": {\n      \"today\": 1500,\n      \"goal\": 2000,\n      \"unit\": \"ml\",\n      \"percentage\": 75\n    },\n    \"sleep\": {\n      \"lastDate\": \"2026-02-09T00:00:00.000Z\",\n      \"duration\": 420,\n      \"quality\": \"good\"\n    },\n    \"fasting\": {\n      \"lastDate\": \"2026-02-09T00:00:00.000Z\",\n      \"duration\": 960\n    }\n  },\n  \"message\": \"Progress summary retrieved successfully\"\n}"
                }
              ]
            }
          ]
        },
