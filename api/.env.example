# Server
PORT=3000
HOST=localhost
NODE_ENV=development

# Database
# Use a managed PostgreSQL service such as Neon, Supabase, Railway, or RDS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lifeline?sslmode=require

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Local media uploads
UPLOAD_PATH=/var/www/lifeline/uploads

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=LifelineTeam
EMAIL_FROM_EMAIL=
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Encryption
BCRYPT_ROUNDS=12

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Food Scanner / Groq
GROQ_API_KEY=
FOOD_SCAN_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
FOOD_SCAN_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
FOOD_SCAN_REQUEST_TIMEOUT_MS=30000
FOOD_SCAN_MAX_TOKENS=800
FOOD_SCAN_TEMPERATURE=0.2
FOOD_SCAN_MAX_IMAGE_BYTES=19922944
FOOD_SCAN_RATE_LIMIT_WINDOW_MS=60000
FOOD_SCAN_RATE_LIMIT_MAX=10
