# Server
PORT=3000
HOST=localhost
NODE_ENV=development

# Database
# Use a managed PostgreSQL service such as Neon, Supabase, Railway, or RDS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lifeline?sslmode=require

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Local media uploads
UPLOAD_PATH=/var/www/lifeline/uploads

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=LifelineTeam
EMAIL_FROM_EMAIL=
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Encryption
BCRYPT_ROUNDS=12

# Google OAuth
GOOGLE_CLIENT_ID=
# Must match the mobile app's EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Sign in with Apple
# Comma-separated Services IDs and/or native bundle IDs accepted as token audiences.
# Include BOTH the iOS bundle ID (app) and the web Services ID (website).
APPLE_CLIENT_IDS=com.irtaza.lifeline,com.irtaza.lifeline.web
# Web flow (Apple Developer > Identifiers > Services IDs). The return URL must be
# registered on the Services ID exactly as written here and must be https.
APPLE_WEB_SERVICES_ID=com.irtaza.lifeline.web
APPLE_WEB_REDIRECT_URI=https://www.makelifeline.com/api/auth/apple/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# StoreKit 2 subscriptions (verified directly with Apple, no RevenueCat)
APPLE_BUNDLE_ID=com.irtaza.lifeline
# Numeric Apple ID of the app (App Store Connect > App Information). Required
# to verify Production transactions.
APPLE_APP_APPLE_ID=
# Keep true: App Review and TestFlight purchase in the Sandbox environment.
APPLE_IAP_ALLOW_SANDBOX=true
APPLE_IAP_ONLINE_CHECKS=true
# Optional override; defaults to ./certs/apple (Apple root CA .cer files).
APPLE_ROOT_CERTIFICATES_DIR=
# App Store Server API key (Users and Access > Integrations > In-App Purchase).
# Recommended: gives authoritative renewal/refund status on every sync.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# Either the .p8 contents with 
 line breaks, or a path to the .p8 file.
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_PATH=

# Food Scanner / Groq
GROQ_API_KEY=
FOOD_SCAN_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
FOOD_SCAN_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
FOOD_SCAN_REQUEST_TIMEOUT_MS=30000
FOOD_SCAN_MAX_TOKENS=800
FOOD_SCAN_TEMPERATURE=0.2
FOOD_SCAN_MAX_IMAGE_BYTES=19922944
FOOD_SCAN_RATE_LIMIT_WINDOW_MS=60000
FOOD_SCAN_RATE_LIMIT_MAX=10
