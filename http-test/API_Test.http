  "email": "{{testEmail}}",
  "otp": "{{otp}}",
  "newPassword": "newpassword123"
}

### Test with invalid OTP
POST {{baseUrl}}/reset-password
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "otp": "000000",
  "newPassword": "newpassword123"
}

### Test with short password
POST {{baseUrl}}/reset-password
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "otp": "{{otp}}",
  "newPassword": "123"
}

### Test with missing fields
POST {{baseUrl}}/reset-password
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}"
}

###############################################
### 9. LOGOUT
###############################################

POST {{baseUrl}}/logout
Content-Type: {{contentType}}

### Note: This endpoint also uses httpOnly cookies

###############################################
### 10. GOOGLE OAUTH (Browser redirect endpoints)
###############################################

### Initiate Google OAuth
GET {{baseUrl}}/google

### Google OAuth Callback (This is handled by Google, just for reference)
# GET {{baseUrl}}/google/callback?code=...

###############################################
### TESTING SCENARIOS
###############################################

### Scenario 1: Complete User Registration Flow
# 1. POST /signup
# 2. Check email for OTP
# 3. POST /verify with OTP
# 4. POST /login

### Scenario 2: Password Reset Flow
# 1. POST /request-password-reset
# 2. Check email for OTP
# 3. POST /reset-password with OTP
# 4. POST /login with new password

### Scenario 3: Token Refresh Flow
# 1. POST /login (get tokens)
# 2. Wait for access token to expire (15 minutes)
# 3. POST /refresh (get new access token)
# 4. GET /me (use new access token)

###############################################
### ERROR TESTING
###############################################

### Test duplicate user signup
POST {{baseUrl}}/signup
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "username": "{{testUsername}}",
  "password": "{{testPassword}}"
}

### Test login with OAuth-only account (no password)
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "oauth-user@example.com",
  "password": "anypassword"
}

### Test accessing protected route without token
GET {{baseUrl}}/me

### Test with malformed JSON
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
  // Missing comma - malformed JSON
}

