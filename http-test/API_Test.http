### Auth API Testing
### Base URL - Update this according to your server configuration
@baseUrl = http://localhost:3000/api/auth
@contentType = application/json

### Variables for testing (update these values during testing)
@testEmail = muhammadnaveedcis@gmail.com
@testUsername = naveed
@testPassword = password123
@accessToken = your_access_token_here
@otp = 000000

###############################################
### 1. USER SIGNUP
###############################################

POST {{baseUrl}}/signup
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "username": "{{testUsername}}",
  "password": "{{testPassword}}"
}

### Alternative signup without username (auto-generated)
POST {{baseUrl}}/signup
Content-Type: {{contentType}}

{
  "email": "newuser@example.com",
  "password": "password123"
}

### Signup with validation errors (testing)
POST {{baseUrl}}/signup
Content-Type: {{contentType}}

{
  "email": "invalid-email",
  "username": "",
  "password": "123"
}

###############################################
### 2. RESEND VERIFICATION EMAIL
###############################################

POST {{baseUrl}}/resend-verification
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}"
}

### Test with non-existent email
POST {{baseUrl}}/resend-verification
Content-Type: {{contentType}}

{
  "email": "nonexistent@example.com"
}

###############################################
### 3. EMAIL VERIFICATION WITH OTP
###############################################

POST {{baseUrl}}/verify
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "otp": "{{otp}}"
}

### Test with invalid OTP
POST {{baseUrl}}/verify
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "otp": "000000"
}

### Test with missing fields
POST {{baseUrl}}/verify
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}"
}

###############################################
### 4. USER LOGIN
###############################################

POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Login with invalid credentials
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "password": "wrongpassword"
}

### Login with non-existent user
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "nonexistent@example.com",
  "password": "{{testPassword}}"
}

### Login with validation errors
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "invalid-email",
  "password": ""
}

###############################################
### 5. GET CURRENT USER
###############################################

GET {{baseUrl}}/me
Authorization: Bearer {{accessToken}}

### Test without authorization header
GET {{baseUrl}}/me

### Test with invalid token
GET {{baseUrl}}/me
Authorization: Bearer invalid_token_here

###############################################
### 6. REFRESH TOKEN
###############################################

POST {{baseUrl}}/refresh
Content-Type: {{contentType}}

### Note: This endpoint uses httpOnly cookies, so make sure cookies are enabled in your HTTP client

