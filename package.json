{
  "name": "lifeline-web",
  "version": "1.0.0",
  "description": "Full stack application with Express API and React TypeScript client",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd api && npm run dev",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd api && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "start": "cd api && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "express",
    "react",
    "typescript",
    "fullstack"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "sonner": "^2.0.7"
  }
}
